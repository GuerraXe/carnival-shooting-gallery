// Windows version resource (Explorer > Properties > Details). Generated by
// CMake from version.rc.in; edit the template, not the copy in the build tree.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       @GALLERY_RC_FILEFLAGS@
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Carnival Shooting Gallery"
            VALUE "FileVersion",      "@GALLERY_VERSION_STRING@"
            VALUE "InternalName",     "CarnivalShootingGallery"
            VALUE "OriginalFilename", "CarnivalShootingGallery.exe"
            VALUE "ProductName",      "Carnival Shooting Gallery"
            VALUE "ProductVersion",   "@GALLERY_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
